        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "commandLineArgs": "--SeedDemo=true"
    },
    "https-manual-browser": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7174;http://localhost:5196",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "commandLineArgs": "--SeedDemo=true"
    }
  }
